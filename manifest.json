{
  "manifest_version": 3,
  "name": "Study Keys \u2014 Read, Highlight, Remember",
  "short_name": "Study Keys",
  "version": "1.7.1",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "minimum_chrome_version": "131",
  "description": "Vim navigation, highlights, notes, Excalidraw and local document review. macOS/Linux beta; local folder helper required.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "sidePanel",
    "nativeMessaging",
    "tabs",
    "tabGroups"
  ],
  "side_panel": {
    "default_path": "panel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Study Keys",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "options_page": "library.html",
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*",
        "file:///*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "highlights.css"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'self' https: http:; img-src 'self' data: blob:; font-src 'self' data:; frame-src 'self'; base-uri 'none'"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "notebook.html"
      ],
      "matches": [
        "http://*/*",
        "https://*/*",
        "file:///*"
      ]
    },
    {
      "resources": [
        "review-media.js"
      ],
      "matches": [
        "file:///*"
      ]
    }
  ],
  "homepage_url": "https://dragod812.github.io/study-keys/"
}
